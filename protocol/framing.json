    },
    "LOG": { "type": 4, "dir": "device_to_host", "fields": [{ "name": "text", "type": "utf8" }] },
    "ACK": {
      "type": 5,
      "dir": "device_to_host",
      "fields": [
        { "name": "cmd_type", "type": "u8" },
        { "name": "result", "type": "u8" }
      ]
    },
    "CMD_SET_CHANNEL": { "type": 129, "dir": "host_to_device", "fields": [{ "name": "channel", "type": "u8" }] },
    "CMD_SET_MODE": { "type": 130, "dir": "host_to_device", "fields": [{ "name": "mode", "type": "u8" }] },
    "CMD_START": { "type": 131, "dir": "host_to_device", "fields": [] },
    "CMD_STOP": { "type": 132, "dir": "host_to_device", "fields": [] },
